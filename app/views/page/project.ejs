<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title><%= project.name %> — Endpoint Monitor</title>
	<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
	<main class="container py-5">
		<a href="/">&larr; Projects</a>
		<h1 class="mt-3"><%= project.name %></h1>
		<p><%= project.baseUrl %></p>
		<h2 class="h4 mt-5">Routes</h2>
		<% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
		<form action="/projects/<%= project.id %>/routes" method="post" class="mb-5">
			<div class="form-group">
				<label for="path">GET route path</label>
				<input id="path" name="path" class="form-control" placeholder="/api/health" maxlength="500" required>
			</div>
			<div class="form-row">
				<div class="form-group col-md-6">
					<label for="expectedStatus">Expected HTTP status</label>
					<input id="expectedStatus" name="expectedStatus" type="number" min="100" max="599" value="200" class="form-control" required>
				</div>
				<div class="form-group col-md-6">
					<label for="maxResponseMs">Maximum response time (ms)</label>
					<input id="maxResponseMs" name="maxResponseMs" type="number" min="1" max="60000" value="5000" class="form-control" required>
				</div>
			</div>
			<button type="submit" class="btn btn-primary">Add route</button>
		</form>

		<% if (routes.length === 0) { %>
			<p>No routes saved yet.</p>
		<% } else { %>
			<div class="table-responsive">
				<table class="table table-striped">
					<thead><tr><th>GET route</th><th>Expected status</th><th>Maximum time</th><th>Latest result</th></tr></thead>
					<tbody>
						<% routes.forEach(function (route) { %>
							<tr>
								<td><%= route.path %></td>
								<td><%= route.expectedStatus %></td>
								<td><%= route.maxResponseMs %> ms</td>
								<td>Not checked yet</td>
							</tr>
						<% }); %>
					</tbody>
				</table>
			</div>
		<% } %>
	</main>
</body>
</html>
